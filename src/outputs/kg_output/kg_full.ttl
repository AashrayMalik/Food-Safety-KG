@prefix fflo: <https://w3id.org/fflo/ontology#> .
@prefix fkg: <https://w3id.org/fkg/ontology#> .
@prefix fso: <https://w3id.org/fso/ontology#> .
@prefix lkif: <http://www.estrellaproject.org/lkif-core/lkif-core.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

xsd:decimal a owl:Class .

fflo: a owl:Ontology ;
    rdfs:label "Food Fraud Lifecycle Ontology derived schema" .

fflo:AcuteEffect a owl:Class ;
    rdfs:subClassOf fflo:CausalHealthEffect .

fflo:ChronicEffect a owl:Class ;
    rdfs:subClassOf fflo:CausalHealthEffect .

fflo:FieldDetected a owl:Class ;
    rdfs:subClassOf fflo:IncidentFinding .

fflo:LabConfirmed a owl:Class ;
    rdfs:subClassOf fflo:IncidentFinding .

fflo:RecallTriggered a owl:Class ;
    rdfs:subClassOf fflo:IncidentFinding .

fflo:SensoryTest a owl:Class ;
    rdfs:subClassOf fflo:DetectionMethod .

fflo:SurveyAggregated a owl:Class ;
    rdfs:subClassOf fflo:IncidentFinding .

fflo:assertsObject a owl:AnnotationProperty .

fflo:assertsPredicate a owl:ObjectProperty .

fflo:assertsSubject a owl:ObjectProperty .

fflo:chunkIndex a owl:AnnotationProperty .

fflo:citesFinding a owl:ObjectProperty ;
    rdfs:domain fflo:RegulatoryAction .

fflo:confidence a owl:AnnotationProperty .

fflo:confirmedBy a owl:ObjectProperty ;
    rdfs:range fso:AnalysisResult .

fflo:evidenceSpan a owl:AnnotationProperty .

fflo:hasEffectType a owl:ObjectProperty .

fflo:hasSignature a owl:ObjectProperty .

fflo:propagatesTo a owl:ObjectProperty .

fflo:signatureDomain a owl:ObjectProperty .

fflo:signatureRange a owl:ObjectProperty .

fflo:snippetId a owl:AnnotationProperty .

fflo:sourceFile a owl:AnnotationProperty .

fflo:sourceId a owl:AnnotationProperty .

fflo:sourceType a owl:AnnotationProperty .

fflo:triggeredAction a owl:ObjectProperty ;
    rdfs:range fflo:RegulatoryAction .

fso:isMeasuredIn a owl:ObjectProperty ;
    rdfs:domain fso:Measurement ;
    rdfs:range fso:UnitOfMeasure .

fso:isResultOf a owl:ObjectProperty ;
    rdfs:domain fso:AnalysisResult ;
    rdfs:range fso:Analysis .

