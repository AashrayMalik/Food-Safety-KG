<urn:fflo:resource:adu-00071> a fflo:Adulterant ;
    rdfs:label "Moldy beans" ;
    fflo:hasDefinition "beans on internal parts of which mould is visible"^^xsd:string .

<urn:fflo:resource:adu-00072> a fflo:Adulterant ;
    rdfs:label "Slaty beans" ;
