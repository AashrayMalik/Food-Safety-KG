fflo:Antioxidant a owl:Class ;
    rdfs:subClassOf fflo:AdditiveFunction .

fflo:Emulsifier a owl:Class ;
    rdfs:subClassOf fflo:AdditiveFunction .

fflo:NaturalAdulterant a owl:Class ;
    rdfs:subClassOf fflo:Adulterant .

fflo:PenaltyReduction a owl:Class ;
    rdfs:subClassOf fflo:RegulatoryActionType .

fflo:hasFraudType a owl:ObjectProperty ;
    rdfs:domain fflo:AdulterationMethod ;
    rdfs:range fflo:FraudType .

fflo:hasIntentionality a owl:ObjectProperty ;
    rdfs:domain fflo:AdulterationMethod ;
    rdfs:range fflo:IntentionalityLevel .

fflo:supportedBy a owl:ObjectProperty ;
    rdfs:range fflo:EvidenceSource .

fflo:violates a owl:ObjectProperty ;
    rdfs:domain fflo:Violation ;
    rdfs:range fflo:PermissibleLimit .

fso:hasLocation a owl:ObjectProperty ;
    rdfs:domain fso:Sample ;
    rdfs:range fso:Location .

<urn:fflo:resource:adu-00008> a fflo:Adulterant ;
    rdfs:label "Mozzarella with low moisture content" ;
    fflo:hasDefinition "a firm or semi-hard homogeneous cheese without holes and is suitable for shredding"^^xsd:string .

<urn:fflo:resource:adu-00011> a fflo:Adulterant ;
    rdfs:label "pit fragments" ;
    fflo:hasDefinition "pieces of pit less than the equivalent of one- half pits, and which weighs at least 5 mg"^^xsd:string .

<urn:fflo:resource:adu-00012> a fflo:Adulterant ;
    rdfs:label "leaves (each 2cm2)" ;
    fflo:hasDefinition "Not compact (Each area or combined Split, Florets and Other Styles"^^xsd:string .

<urn:fflo:resource:adu-00013> a fflo:Adulterant ;
    rdfs:label "Extraneous Vegetable Material" ;
    fflo:hasDefinition "Vegetable material from the bean plant, other than pod, such as leaf or vine, but excluding stem ends; other harmless vegetable material, not purposely included as an ingredient."^^xsd:string .

<urn:fflo:resource:adu-00014> a fflo:Adulterant ;
    rdfs:label "Stem End" ;
    fflo:hasDefinition "A piece of the immediate stem which attaches the pod to the vine stem, whether present still attached to the pod or present loose in the product."^^xsd:string .

<urn:fflo:resource:adu-00015> a fflo:Adulterant ;
    rdfs:label "Minor Blemish" ;
    fflo:hasDefinition "Each piece blemished due to insect or pathological damage affecting an area greater than a 3 mm diameter circle, or blemished by other means to a degree which noticeably detracts from its appearance."^^xsd:string .

<urn:fflo:resource:adu-00016> a fflo:Adulterant ;
    rdfs:label "Major Blemish" ;
    fflo:hasDefinition "Each piece blemished due to insect or pathological damage affecting an area greater than 6 mm diameter circle, or blemished by other means to a degree which seriously detracts from its appearance."^^xsd:string .

<urn:fflo:resource:adu-00017> a fflo:Adulterant ;
    rdfs:label "Mechanical Damage" ;
    fflo:hasDefinition "A unit, in whole and cut styles, that is broken or split into two parts, crushed, or has very ragged edges to an extent that the appearance is seriously affected."^^xsd:string .

<urn:fflo:resource:adu-00018> a fflo:Adulterant ;
    rdfs:label "Undeveloped" ;
    fflo:hasDefinition "Each unit which measures less than 3 mm at its widest point."^^xsd:string .

<urn:fflo:resource:adu-00019> a fflo:Adulterant ;
    rdfs:label "Tough Strings" ;
    fflo:hasDefinition "Tough fibre which will support a weight of 250 g for 5"^^xsd:string .

<urn:fflo:resource:adu-00020> a fflo:Adulterant ;
    rdfs:label "Fibrous Unit" ;
    fflo:hasDefinition "Each piece having parchment like material formed during the ripening of the pod, to the extent that the eating quality is seriously affected."^^xsd:string .

<urn:fflo:resource:adu-00021> a fflo:Adulterant ;
    rdfs:label "Small Pieces" ;
    fflo:hasDefinition "bean pieces less than 10 mm in length including loose seeds and pieces of seeds."^^xsd:string .

<urn:fflo:resource:adu-00023> a fflo:Adulterant ;
    rdfs:label "carob chips" ;
    fflo:isSubstituteFor <urn:fflo:resource:foo-00285> .

<urn:fflo:resource:adu-00027> a fflo:Adulterant ;
    rdfs:label "Chopped spinach" ;
    fflo:hasDefinition "parts of leaves of spinach cut into small pieces but not comminuted to a pulp or puree"^^xsd:string .

<urn:fflo:resource:adu-00028> a fflo:Adulterant ;
    rdfs:label "shrunken or shrivelled" ;
    fflo:hasDefinition "almond kernel which is extremely flat and wrinkled, or almond kernel with desiccated, dried out or tough portions when the affected portion represents more than one quarter of the kernel"^^xsd:string .

<urn:fflo:resource:adu-00029> a fflo:Adulterant ;
    rdfs:label "split or broken kernel" ;
    fflo:hasDefinition "mechanically damaged almond kernel from which more than one quarter of the kernel"^^xsd:string .

<urn:fflo:resource:adu-00031> a fflo:Adulterant ;
    rdfs:label "rotten" ;
    fflo:hasDefinition "significant decomposition or decay caused by the action of micro-organisms or other biological processes"^^xsd:string .

<urn:fflo:resource:adu-00032> a fflo:Adulterant ;
    rdfs:label "insect or pest damage" ;
    fflo:hasDefinition "visible damage or contamination caused by insects, mites, rodents or other animal pests"^^xsd:string .

<urn:fflo:resource:adu-00033> a fflo:Adulterant ;
    rdfs:label "Spoiled fungi" ;
    fflo:hasDefinition "fungi which are brownish or rotten as a result of attack by microorganisms and/or mould"^^xsd:string .

<urn:fflo:resource:adu-00035> a fflo:Adulterant ;
    rdfs:label "smoke condensates" ;
    fflo:hasDefinition "products obtained by controlled thermal degradation of wood in a limited supply of oxygen"^^xsd:string .

<urn:fflo:resource:adu-00047> a fflo:Adulterant ;
    rdfs:label "fortification" ;
    fflo:hasDefinition "deliberately increasing the content of essential micronutrients in a food so as to improve the nutritional quality of food and to provide public health benefit with minimal risk to"^^xsd:string .

<urn:fflo:resource:adu-00048> a fflo:Adulterant ;
    rdfs:label "fortificant" ;
    fflo:hasDefinition "a substance added to food to provide micronutrients but does not include nutraceuticals or foods for Special"^^xsd:string .

<urn:fflo:resource:adu-00056> a fflo:Adulterant ;
    rdfs:label "Sida cordifolia" ;
    fflo:hasDefinition "Mahaballa / Nagaballa"^^xsd:string .

<urn:fflo:resource:adu-00057> a fflo:Adulterant ;
    rdfs:label "Terminalia chebula" ;
    fflo:hasDefinition "Myrobalan / Harad"^^xsd:string .

<urn:fflo:resource:adu-00058> a fflo:Adulterant ;
    rdfs:label "Trigonella foenum-graecum" ;
    fflo:hasDefinition "Methika/Methi/Fenugreek"^^xsd:string .

<urn:fflo:resource:adu-00072> a fflo:Adulterant ;
    rdfs:label "Moldy beans" ;
    fflo:hasDefinition "beans on internal parts of which mould is visible"^^xsd:string .

<urn:fflo:resource:adu-00073> a fflo:Adulterant ;
    rdfs:label "Slaty beans" ;
    fflo:hasDefinition "beans which show a slaty colour over half or more of the surface exposed"^^xsd:string .

<urn:fflo:resource:adu-00074> a fflo:Adulterant ;
    rdfs:label "Insect damaged" ;
    fflo:hasDefinition "beans, the internal parts of which contain insects at any stage of development or which have been damaged beans, attacked by insects causing damage visible to the naked eyes"^^xsd:string .

<urn:fflo:resource:adu-00075> a fflo:Adulterant ;
    rdfs:label "Flat beans" ;
    fflo:hasDefinition "beans of which the cotyledons are so thin that it is not possible to obtain a cotyledons surface by cutting"^^xsd:string .

<urn:fflo:resource:adu-00076> a fflo:Adulterant ;
    rdfs:label "Cicatrix" ;
    fflo:hasDefinition "Scar of healed-up wound"^^xsd:string .

<urn:fflo:resource:adu-00077> a fflo:Adulterant ;
    rdfs:label "Domestic" ;
    fflo:hasDefinition "Small grease spot in the casing"^^xsd:string .

<urn:fflo:resource:adu-00078> a fflo:Adulterant ;
    rdfs:label "Kink" ;
    fflo:hasDefinition "Twisted loop in the casing"^^xsd:string .

<urn:fflo:resource:adu-00079> a fflo:Adulterant ;
    rdfs:label "Nodule" ;
    fflo:hasDefinition "Small rounded structure"^^xsd:string .

<urn:fflo:resource:adu-00080> a fflo:Adulterant ;
    rdfs:label "Black Node" ;
    fflo:hasDefinition "Black node usually caused by the residue of the ingesta or slime left behind in the casing"^^xsd:string .

<urn:fflo:resource:adu-00081> a fflo:Adulterant ;
    rdfs:label "Rust" ;
    fflo:hasDefinition "Black spots caused by putrefaction due to bacterial or fungal"^^xsd:string .

<urn:fflo:resource:adu-00082> a fflo:Adulterant ;
    rdfs:label "Salt Burn" ;
    fflo:hasDefinition "Areas of discolouration generally caused by: (a) the entry of air-into tin containers in which the casings are packed, and/or (b) by the use of poor quality salt"^^xsd:string .

