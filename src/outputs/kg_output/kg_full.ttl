        fflo:FoodCategory ;
    rdfs:label "Foreign matter" ;
    fflo:hasDefinition <urn:fflo:resource:det-00076>,
        <urn:fflo:resource:foo-00431>,
        "The presence in the sample unit of any matter which has not been derived from bivalve molluscs, does not pose a threat to human health and is readily recognized without magnification or is present at a level determined by any method including magnification, that indicates non-compliance with good manufacturing and sanitation practices"^^xsd:string,
        "The presence in the sample unit of any matter which has not been derived from scallops, does not pose a threat to human health, and is readily recognised without magnification or is present at a level determined by any method including magnification that indicates non-compliance with good manufacturing and sanitation practices"^^xsd:string,
        "any visible objectionable foreign detectable matter or material not usually associated with the natural components of the spice"^^xsd:string,
        "presence in the sample unit of any matter which has not been derived from bivalve molluscs"^^xsd:string ;
