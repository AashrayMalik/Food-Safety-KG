    rdfs:label "2-Class Sampling Plan" ;
    fflo:hasDefinition "Sampling plan where n, c and m are specified"^^xsd:string,
        "Satisfactory, if all the values observed are ≤ m"^^xsd:string,
        "Satisfactory, if all the values observed are ≤ m; Unsatisfactory, if one or more of the values observed are >m"^^xsd:string,
        "Unsatisfactory, if one or more of the values observed are >m"^^xsd:string,
        "Unsatisfactory, if one or more of the values observed are >m or more than c values are > m"^^xsd:string,
        "where n, c and m are specified"^^xsd:string .

