@prefix fflo: <https://w3id.org/fflo/ontology#> .
@prefix fkg: <https://w3id.org/fkg/ontology#> .
@prefix fso: <https://w3id.org/fso/ontology#> .
@prefix lkif: <http://www.estrellaproject.org/lkif-core/lkif-core.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lkif:created_by a owl:ObjectProperty ;
    rdfs:domain fflo:FoodStandard ;
    rdfs:range fflo:RegulatoryBody .

xsd:decimal a owl:Class .

xsd:string a owl:Class .

prov:used a owl:ObjectProperty ;
    rdfs:domain fflo:AdulterationAct ;
    rdfs:range fkg:Food .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:domain fflo:AdulterationAct ;
    rdfs:range fflo:FoodBusinessOperator .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:domain fflo:IncidentFinding ;
    rdfs:range fflo:FoodBusinessOperator .

prov:wasGeneratedBy a owl:ObjectProperty ;
    fflo:hasSignature [ fflo:signatureDomain fflo:SpreadEvent ;
            fflo:signatureRange fflo:TransformationEvent ],
        [ fflo:signatureDomain fflo:Adulterant ;
            fflo:signatureRange fflo:AdulterationAct ] .

prov:wasInfluencedBy a owl:ObjectProperty ;
    rdfs:domain fflo:SpreadEvent ;
    rdfs:range fflo:AdulterationAct .

fflo: a owl:Ontology ;
    rdfs:label "Food Fraud Lifecycle Ontology derived schema" .

